# Redirect Electron binary downloads to npmmirror. Electron's default
# CDN (github.com/electron/electron/releases) is sometimes flaky and
# `npm install` fails with `socket hang up` during the postinstall.
# npmmirror serves bit-for-bit copies. npm propagates this key as
# `npm_config_electron_mirror`, which is what @electron/get reads.
# The key uses a hyphen because npm silently rewrites dashes to
# underscores in the propagated env var name.
electron-mirror=https://npmmirror.com/mirrors/electron/